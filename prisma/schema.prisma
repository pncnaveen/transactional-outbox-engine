datasource db {
    provider = "postgresql"
    url = env("DB_URL")
}

generator client {
    provider = "prisma-client"
    output   = "../src/infrastructure/prisma/generated"
}

model User {
    id        String  @id @db.Char(26)
    firstName String  @map("first_name") @db.VarChar(50)
    lastName  String  @map("last_name") @db.VarChar(50)
    email     String  @unique
    orders    Order[]
    outboxMessages OutboxMessage[]

    @@map("users")
}

model Order {
    id             String          @id @db.Char(26)
    userId         String          @map("user_id") @db.Char(26)
    user           User            @relation(fields: [userId], references: [id])
    productId      String          @map("product_id") @db.Char(26)
    product        Product         @relation(fields: [productId], references: [id])
    createdAt      DateTime        @default(now()) @map("created_at")
    updatedAt      DateTime        @updatedAt @map("updated_at")
    orderStatus    OrderStatus     @default(PROCESSING)
    quantity       Int             @default(1)
    outboxMessages OutboxMessage[]

    @@map("orders")
}

model Product {
    id     String  @id @db.Char(26)
    orders Order[]
    name   String  @db.VarChar(100)
    price  Decimal @db.Decimal(10, 2)

    @@map("products")
}

model OutboxMessage {
    id             String        @id @db.Char(26)
    createdAt      DateTime      @default(now()) @map("created_at")
    updatedAt      DateTime      @updatedAt @map("updated_at")
    processedAt    DateTime?     @map("processed_at")
    failedAt       DateTime?     @map("failed_at")
    eventType      EventType     @map("event_type")
    orderId        String?        @map("order_id") @db.Char(26)
    order          Order?         @relation(fields: [orderId], references: [id])
    messsageStatus MessageStatus @default(PROCESSING) @map("messsage_status")
    retryCount Int @default(0) @map("retry_count")
    errorMessage String? @map("error") @db.VarChar(255)
    scheduledAt DateTime? @map("scheduled_at")
    userId String @map("user_id") @db.Char(26)
    account User @relation(fields: [userId], references: [id])

    @@index([scheduledAt, userId])
    @@map("outbox_messages")
}

enum OrderStatus {
    PROCESSING
    MESSAGE_SENT
    MESSAGE_SENT_FAILED
    PROCESSED
}

enum MessageStatus {
    RECEIVED
    PROCESSING
    PROCESSED
    FAILED
}

enum EventType {
    ORDER_CREATED
    USER_CREATED
}
